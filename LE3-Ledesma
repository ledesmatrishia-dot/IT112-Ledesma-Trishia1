#include <stdio.h>

int main()
{
    char name[30];
    char section[20];
    float num1, num2, sum, diff, product, quotient;
    
    printf("Enter Complete Name: ");
    scanf("%[^\n]", name);
    printf("Enter Section: ");
    scanf("%s", section);
    printf("Enter first number: ");
    scanf("%f", &num1);
    printf("Enter second number: ");
    scanf("%f", &num2);
    sum = num1 + num2;
    diff = num1 - num2;
    product = num1 * num2;
    quotient = num1 / num2;
    printf("\nStudent Calculator\n");
    printf("Student Name: %s\n", name);
    printf("Section: %s\n", section);
    printf("results:\n");
    printf("%.0f + %.0f = %.0f\n", num1, num2, sum);
    printf("%.0f - %.0f = %.0f\n", num1, num2, diff);
    printf("%.0f * %.0f = %.0f\n", num1, num2, product);
    printf("%.0f / %.0f = %.2f\n", num1, num2, quotient);

    
    return 0;
}
